#!/bin/sh
# Pre-commit hook: formatting + lints must pass before a commit is recorded.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Uses git's native hooksPath rather than a hook-manager crate, so this adds no
# dependency to Cargo.toml.
#
# Bypass in an emergency with `git commit --no-verify` (then fix it immediately).

set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy -D warnings"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-commit: ok"
